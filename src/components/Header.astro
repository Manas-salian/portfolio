---
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<nav>
  <a href="/" class:list={{ active: isActive("/") && pathname === "/" }}>Home</a>
  <a href="/posts/" class:list={{ active: isActive("/posts") }}>Posts</a>
  <a href="/tags/" class:list={{ active: isActive("/tags") }}>Tags</a>
  {SITE.showArchives && (
    <a href="/archives/" class:list={{ active: isActive("/archives") }}>Archives</a>
  )}
  <a target="_blank" href="/rss.xml">RSS</a>
</nav>
