---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content">

    <h1>Manas S</h1>
    <p>
      Cybersecurity nerd at Sahyadri College of Engineering and Management.
      Passionate about tech, computers, talking and painting.
    </p>

    <p class="social-links">
      {SOCIALS.map((social, i) => (
        <>
          <a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}</a>
          {i < SOCIALS.length - 1 && <span class="sep">·</span>}
        </>
      ))}
    </p>

    <hr />

    <h2>Experience</h2>

    <p>
      <strong>Student Researcher</strong> — CoE Digital Forensics and Cybersecurity
      <em>(Oct – Dec 2024)</em><br />
      Researched wireless protocol vulnerabilities, built a Pwnagotchi for WPA/WPA2 handshake collection, configured network topologies with Cisco Packet Tracer.
    </p>

    <p>
      <strong>QA & Testing Intern</strong> — Stoxii Tech Solutions
      <em>(Jul – Aug 2025)</em><br />
      Security testing across Web and Android platforms, identified 5+ critical flaws. Built the blogs section using Next.js (5,000+ users).
    </p>

    <hr />

    <h2>Skills</h2>

    <p>
      <strong>Languages:</strong> C, C++, Bash, Python, SQL, JavaScript<br />
      <strong>Tools:</strong> Burp Suite, Wireshark, Splunk, NMAP, Metasploit, Git, Docker, Linux<br />
      <strong>Standards:</strong> OWASP Top 10
    </p>

    <hr />

    <h2>Projects</h2>

    <p><strong>Pwnagotchi</strong> — Raspberry Pi device for automated WPA/WPA2 handshake collection using AI-based reinforcement learning.</p>

    <p><strong>Homeserver</strong> — Ubuntu Server setup with Samba file sharing, Jellyfin media streaming, and WireGuard VPN for secure remote access.</p>

    <p><strong>Redactly.ai</strong> — PDF redaction pipeline using PyMuPDF, Tesseract OCR, and Microsoft Presidio for PII detection.</p>

    <p><strong>Tulu NMT</strong> — Neural Machine Translation for the Tulu language using IndicTrans2 with transfer learning.</p>

    <hr />

    <h2>Community</h2>

    <p>
      <strong>Community Lead</strong> — Sahyadri Open Source Community <em>(Sep 2024 – Present)</em><br />
      Led DevHost (1,000+ attendees, 30+ speakers), organized CTFs, run cybersecurity workshops.
    </p>

    <h2>Certifications</h2>

    <ul>
      <li>Google Cybersecurity Certification (Coursera, 2024)</li>
      <li>JLPT N5 (The Japan Foundation, 2025)</li>
    </ul>

    <hr />

    {featuredPosts.length > 0 && (
      <>
        <h2>Featured Posts</h2>
        <ul class="post-list">
          {featuredPosts.map(data => <Card variant="h3" {...data} />)}
        </ul>
      </>
    )}

    {recentPosts.length > 0 && (
      <>
        <h2>Recent Posts</h2>
        <ul class="post-list">
          {recentPosts.map(
            (data, index) =>
              index < SITE.postPerIndex && <Card variant="h3" {...data} />
          )}
        </ul>
        <p><a href="/posts/">All posts &rarr;</a></p>
      </>
    )}

  </main>
  <Footer />
</Layout>
