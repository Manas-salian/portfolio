---
export interface Props {
  pageTitle: string | [string, string];
  titleTransition?: string;
  pageDesc?: string;
}

const { props } = Astro;
const title = Array.isArray(props.pageTitle)
  ? props.pageTitle.join(" ")
  : props.pageTitle;
---

<main id="main-content">
  <h1>{title}</h1>
  {props.pageDesc && <p><em>{props.pageDesc}</em></p>}
  <slot />
</main>
