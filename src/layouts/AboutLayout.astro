---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Socials from "@/components/Socials.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { Image } from "astro:assets";
import manasImage from "@/assets/images/manas.png";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    showSocials?: boolean;
  };
}

const { frontmatter } = Astro.props;
const showSocials = frontmatter.showSocials ?? false;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <Image
        src={manasImage}
        alt="Manas"
        width={150}
        height={150}
        class="float-right ml-4 mb-2 rounded-sm aspect-square object-cover w-32 h-32 sm:w-36 sm:h-36"
      />
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      {showSocials && <div class="my-4 not-prose"><Socials /></div>}
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
